{
  "name": "react-design-library-agent",
  "version": "0.1.0",
  "description": "Agent that clones a GitHub repo of React components, renders each to HTML, screenshots it and builds a design documentation library.",
  "type": "module",
  "bin": { "design-library": "./src/cli.mjs" },
  "scripts": {
    "setup": "playwright install chromium",
    "build:swiss": "node src/cli.mjs https://github.com/detonnate/reactSwissComponents --examples examples/swiss.examples.jsx"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.48.0",
    "ts-morph": "^24.0.0"
  }
}

